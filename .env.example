# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables. See docs/launch.md.

# Canonical site origin, no trailing slash. Used for metadata, canonical URLs, the sitemap, the RSS feed,
# Open Graph URLs and the links in waitlist confirmation emails.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend (contact and waitlist emails). Optional for local and static builds; the API routes
# answer 503 with a clear message when these are missing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender on your verified Resend domain.
CONTACT_FROM_EMAIL=SmartxDreams <hello@example.com>
# Team inbox: receives contact-form messages and waitlist consent records.
CONTACT_TO_EMAIL=team@example.com

# Signs waitlist confirmation links (HMAC-SHA256). At least 32 random characters:
#   openssl rand -hex 32
# Changing it invalidates confirmation links that have not been used yet.
WAITLIST_SECRET=
# Optional: Resend segment that confirmed waitlist contacts are added to.
RESEND_WAITLIST_SEGMENT_ID=

# Set by Vercel automatically (production, preview or development). Analytics run only in production,
# and draft blog posts are hidden only in production.
# VERCEL_ENV=

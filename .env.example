# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Canonical site origin, no trailing slash. Used for metadata, the sitemap and Open Graph URLs.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend (contact and waitlist emails). Optional for local and static builds; the API routes
# answer with a clear error when these are missing.
RESEND_API_KEY=
# Sender on your verified Resend domain, for example: SmartxDreams <hello@example.com>
CONTACT_FROM_EMAIL=
# Team inbox that receives contact form messages.
CONTACT_TO_EMAIL=

# Set by Vercel automatically (production, preview or development). Analytics run only in production.
# VERCEL_ENV=
